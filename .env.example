# Server-side only. Read by /api/* functions via process.env. Never prefix with VITE_.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model id(s) from AI Studio. Comma-separate to fall back to the next model on 429/503,
# e.g. gemini-3.5-flash,gemini-3.5-flash-lite
GEMINI_MODEL=
